[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/common/top_bar.gd" id="1_top"]

[node name="TopBar" type="PanelContainer"]
custom_minimum_size = Vector2(0, 22)
script = ExtResource("1_top")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 20

[node name="DateBox" type="HBoxContainer" parent="HBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="DayLabel" type="Label" parent="HBox/DateBox"]
unique_name_in_owner = true
layout_mode = 2
text = "2027/1/1（金）"

[node name="DayCountLabel" type="Label" parent="HBox/DateBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"SmallLabel"
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
text = "1日目"

[node name="MoneyLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
text = "¥0"

[node name="ReputationBox" type="VBoxContainer" parent="HBox"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 1

[node name="ReputationLabel" type="Label" parent="HBox/ReputationBox"]
unique_name_in_owner = true
layout_mode = 2
text = "無名店 ★評判 0"

[node name="RankBar" type="ProgressBar" parent="HBox/ReputationBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 3)
layout_mode = 2
mouse_filter = 2
max_value = 1.0
step = 0.0
show_percentage = false

[node name="Spacer" type="Control" parent="HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="TimeLabel" type="Label" parent="HBox"]
unique_name_in_owner = true
layout_mode = 2
text = "残り 2:00"
