[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/prep/shelf_plan_panel.gd" id="1_plan"]

[node name="ShelfPlanPanel" type="PanelContainer"]
script = ExtResource("1_plan")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Header" type="HBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="TitleLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeaderLabel"
text = "開店時の置き場"

[node name="Slots" type="HBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 3

[node name="AddRow" type="HFlowContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 3
theme_override_constants/v_separation = 3
