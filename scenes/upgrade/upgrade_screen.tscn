[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/upgrade/upgrade_screen.gd" id="1_upgrade"]
[ext_resource type="Script" path="res://scripts/ui/safe_area_container.gd" id="2_safe"]
[ext_resource type="PackedScene" path="res://scenes/common/top_bar.tscn" id="3_top"]
[ext_resource type="Script" path="res://scripts/ui/drag_scroll_container.gd" id="4_scroll"]
[ext_resource type="PackedScene" path="res://scenes/common/confirm_dialog.tscn" id="5_dialog"]
[ext_resource type="PackedScene" path="res://scenes/common/detail_popup.tscn" id="6_detail"]

[node name="UpgradeScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_upgrade")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.13, 0.11, 0.1, 1)

[node name="SafeArea" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_safe")

[node name="VBox" type="VBoxContainer" parent="SafeArea"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TopBar" parent="SafeArea/VBox" instance=ExtResource("3_top")]
layout_mode = 2
show_time = false

[node name="Header" type="HBoxContainer" parent="SafeArea/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TitleLabel" type="Label" parent="SafeArea/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "お店を強化"

[node name="HelpLabel" type="Label" parent="SafeArea/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 8
theme_type_variation = &"SmallLabel"
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
text = "説明"
clip_text = true
text_overrun_behavior = 3

[node name="Scroll" type="ScrollContainer" parent="SafeArea/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("4_scroll")

[node name="List" type="VBoxContainer" parent="SafeArea/VBox/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 3

[node name="Footer" type="HBoxContainer" parent="SafeArea/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="FooterTexts" type="VBoxContainer" parent="SafeArea/VBox/Footer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="MessageLabel" type="Label" parent="SafeArea/VBox/Footer/FooterTexts"]
unique_name_in_owner = true
layout_mode = 2
text = "強化しない日は、そのまま「次の日へ」"
clip_text = true
text_overrun_behavior = 3

[node name="HolidayLabel" type="Label" parent="SafeArea/VBox/Footer/FooterTexts"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallLabel"
theme_override_colors/font_color = Color(0.6, 0.85, 1, 1)
text = "明日は定休日です"
clip_text = true
text_overrun_behavior = 3

[node name="NextButton" type="Button" parent="SafeArea/VBox/Footer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(140, 36)
layout_mode = 2
text = "次の日へ"

[node name="ConfirmDialog" parent="." instance=ExtResource("5_dialog")]
unique_name_in_owner = true
layout_mode = 1

[node name="DetailPopup" parent="." instance=ExtResource("6_detail")]
unique_name_in_owner = true
layout_mode = 1
